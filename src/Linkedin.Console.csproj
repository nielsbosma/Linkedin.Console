<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- dotnet tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>linkedin</ToolCommandName>

    <!-- NuGet metadata -->
    <PackageId>Linkedin.Console</PackageId>
    <Version>1.2.0</Version>
    <Authors>nielsbosma</Authors>
    <Description>CLI for your own LinkedIn data through LinkedIn's Member Data Portability API, and for public profiles and posts via Apify. YAML-first output optimized for LLM agent consumption.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/nielsbosma/Linkedin.Console</RepositoryUrl>
    <PackageTags>cli;dotnet-tool;linkedin</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="1.0.0-alpha.0.16" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
</Project>
